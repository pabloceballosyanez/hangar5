generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ============================================================
// === TURISMO DE AVENTURA (existente — no modificar) =========
// ============================================================

model Item {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  type        String
  description String?
  price       Int
  capacity    String?
  image       String?
  featured    Boolean   @default(false)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bookings    Booking[]
}

model Booking {
  id              String   @id @default(cuid())
  itemId          String
  item            Item     @relation(fields: [itemId], references: [id])
  customerName    String
  customerEmail   String
  customerPhone   String?
  startDate       DateTime
  endDate         DateTime
  guests          Int      @default(1)
  totalPrice      Int
  status          String   @default("pending")
  stripeSessionId String?
  paymentMethod   String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([itemId, startDate, endDate])
  @@index([status])
}

// ============================================================
// === CATÁLOGO ===============================================
// ============================================================

model Category {
  id        String     @id @default(cuid())
  name      String
  sortOrder Int        @default(0)
  kind      String
  isActive  Boolean    @default(true)
  imageUrl  String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  menuItems MenuItem[]
}

model MenuItem {
  id                     String                  @id @default(cuid())
  categoryId             String
  category               Category                @relation(fields: [categoryId], references: [id])
  name                   String
  description            String?
  basePrice              Int
  imageUrl               String?
  isActive               Boolean                 @default(true)
  prepStation            String
  estimatedPrepMinutes   Int                     @default(10)
  sortOrder              Int                     @default(0)
  sku                    String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  variants               MenuItemVariant[]
  menuItemModifierGroups MenuItemModifierGroup[]
  recipe                 Recipe?
  orderItems             OrderItem[]

  @@index([categoryId, isActive])
}

model MenuItemVariant {
  id         String      @id @default(cuid())
  menuItemId String
  menuItem   MenuItem    @relation(fields: [menuItemId], references: [id])
  name       String
  priceDelta Int         @default(0)
  isDefault  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  orderItems OrderItem[]
}

model ModifierGroup {
  id                     String                  @id @default(cuid())
  name                   String
  minSelections          Int                     @default(0)
  maxSelections          Int                     @default(1)
  isRequired             Boolean                 @default(false)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  modifiers              Modifier[]
  menuItemModifierGroups MenuItemModifierGroup[]
}

model Modifier {
  id                 String              @id @default(cuid())
  modifierGroupId    String
  modifierGroup      ModifierGroup       @relation(fields: [modifierGroupId], references: [id])
  name               String
  priceDelta         Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  orderItemModifiers OrderItemModifier[]
}

model MenuItemModifierGroup {
  id              String        @id @default(cuid())
  menuItemId      String
  menuItem        MenuItem      @relation(fields: [menuItemId], references: [id])
  modifierGroupId String
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id])

  @@unique([menuItemId, modifierGroupId])
}

// ============================================================
// === RECETAS E INVENTARIO ===================================
// ============================================================

model Ingredient {
  id             String          @id @default(cuid())
  name           String
  unit           String
  currentStock   Float           @default(0)
  minStock       Float           @default(0)
  cost           Int             @default(0)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  recipeItems    RecipeItem[]
  stockMovements StockMovement[]
}

model Recipe {
  id             String       @id @default(cuid())
  menuItemId     String?      @unique
  menuItem       MenuItem?    @relation(fields: [menuItemId], references: [id])
  parentRecipeId String?
  parentRecipe   Recipe?      @relation("RecipeExtensions", fields: [parentRecipeId], references: [id])
  childRecipes   Recipe[]     @relation("RecipeExtensions")
  isTemplate     Boolean      @default(false)
  yieldQuantity  Float        @default(1)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  recipeItems    RecipeItem[]
}

model RecipeItem {
  id           String     @id @default(cuid())
  recipeId     String
  recipe       Recipe     @relation(fields: [recipeId], references: [id])
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  quantity     Float

  @@unique([recipeId, ingredientId])
}

model StockMovement {
  id           String     @id @default(cuid())
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  delta        Float
  reason       String
  notes        String?
  createdAt    DateTime   @default(now())

  @@index([ingredientId, createdAt])
}

// ============================================================
// === CLIENTES Y CUENTAS CORRIENTES ==========================
// ============================================================

model Customer {
  id             String                 @id @default(cuid())
  name           String
  phone          String?
  email          String?
  notes          String?
  isActive       Boolean                @default(true)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  sessions       ServiceSession[]
  ledgerEntries  CustomerLedgerEntry[]
  payments       Payment[]
}

model CustomerLedgerEntry {
  id               String          @id @default(cuid())
  customerId       String
  customer         Customer        @relation(fields: [customerId], references: [id])
  amount           Int // signed: positive = customer owes us, negative = we owe customer. MXN cents.
  type             String // "CHARGE" | "PAYMENT" | "REFUND" | "ADJUSTMENT"
  serviceSessionId String?
  serviceSession   ServiceSession? @relation(fields: [serviceSessionId], references: [id])
  note             String?
  createdAt        DateTime        @default(now())

  @@index([customerId, createdAt])
}

// ============================================================
// === SALA Y SESIONES ========================================
// ============================================================

model Table {
  id        String           @id @default(cuid())
  number    String           @unique
  name      String?
  qrToken   String           @unique
  capacity  Int
  location  String?
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  sessions  ServiceSession[]
}

model ServiceSession {
  id         String    @id @default(cuid())
  type       String    @default("TABLE") // "TABLE" | "TAB" | "WALKIN"
  label      String    // e.g. "Mesa 5", "Grupo Juan", "Barra-1"
  tableId    String?   // FK → Table (null for TAB/WALKIN)
  table      Table?    @relation(fields: [tableId], references: [id])
  customerId String?   // FK → Customer (null for anonymous)
  customer   Customer? @relation(fields: [customerId], references: [id])
  status     String    @default("OPEN") // "OPEN" | "CLOSED"
  openedAt   DateTime  @default(now())
  closedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  orders     Order[]
  payments   Payment[]
  ledgerEntries CustomerLedgerEntry[]

  @@index([status, type])
}

// ============================================================
// === PEDIDOS ================================================
// ============================================================

model Order {
  id                String             @id @default(cuid())
  serviceSessionId  String
  serviceSession    ServiceSession     @relation(fields: [serviceSessionId], references: [id])
  customerName      String?
  customerEmail     String?
  customerPhone     String?
  source            String
  status            String             @default("DRAFT")
  subtotal          Int                @default(0)
  tax               Int                @default(0)
  total             Int                @default(0)
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  orderItems        OrderItem[]
  statusEvents      OrderStatusEvent[]
  payments          Payment[]

  @@index([serviceSessionId, status, createdAt])
  @@index([source, status, createdAt])
}

model OrderItem {
  id                  String              @id @default(cuid())
  orderId             String
  order               Order               @relation(fields: [orderId], references: [id])
  menuItemId          String
  menuItem            MenuItem            @relation(fields: [menuItemId], references: [id])
  variantId           String?
  variant             MenuItemVariant?    @relation(fields: [variantId], references: [id])
  quantity            Int                 @default(1)
  unitPrice           Int
  specialInstructions String?
  status              String              @default("PENDING")
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  modifiers           OrderItemModifier[]
  statusEvents        OrderStatusEvent[]

  @@index([orderId, status])
}

model OrderItemModifier {
  id           String    @id @default(cuid())
  orderItemId  String
  orderItem    OrderItem @relation(fields: [orderItemId], references: [id])
  modifierId   String
  modifier     Modifier  @relation(fields: [modifierId], references: [id])
  modifierName String
  priceDelta   Int
}

model OrderStatusEvent {
  id          String     @id @default(cuid())
  orderId     String
  order       Order      @relation(fields: [orderId], references: [id])
  orderItemId String?
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id])
  fromStatus  String
  toStatus    String
  timestamp   DateTime   @default(now())

  @@index([orderId, timestamp])
}

// ============================================================
// === PAGOS ==================================================
// ============================================================

model Payment {
  id               String           @id @default(cuid())
  orderId          String?          // FK → Order (null for ON_ACCOUNT payments)
  order            Order?           @relation(fields: [orderId], references: [id])
  serviceSessionId String?          // FK → ServiceSession (for session-level payments)
  serviceSession   ServiceSession?  @relation(fields: [serviceSessionId], references: [id])
  customerId       String?          // FK → Customer (for account payments)
  customer         Customer?        @relation(fields: [customerId], references: [id])
  amount           Int // total charged in MXN cents
  method           String // "MP" | "CASH" | "CARD" | "TRANSFER"
  status           String           @default("PENDING") // "PENDING" | "COMPLETED" | "REFUNDED"
  note             String?
  mpPaymentId      String?
  mpPreferenceId   String?
  paidAt           DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([orderId, status])
  @@index([serviceSessionId])
  @@index([customerId])
}

// ============================================================
// === STAFF Y RRHH ===========================================
// ============================================================

model Staff {
  id         String       @id @default(cuid())
  name       String
  role       String
  phone      String?
  email      String?
  hourlyRate Int          @default(0)
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  shifts     StaffShift[]
  clocks     StaffClock[]
}

model StaffShift {
  id        String   @id @default(cuid())
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id])
  date      DateTime
  startTime DateTime
  endTime   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffId, date])
}

model StaffClock {
  id        String   @id @default(cuid())
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id])
  timestamp DateTime @default(now())
  type      String

  @@index([staffId, timestamp])
}

// ============================================================
// === GASTOS FIJOS ===========================================
// ============================================================

model FixedExpense {
  id          String   @id @default(cuid())
  description String
  amount      Int
  category    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
