generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ============================================================
// === TURISMO DE AVENTURA (existente — no modificar) =========
// ============================================================

model Item {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  type        String
  description String?
  price       Int
  capacity    String?
  image       String?
  featured    Boolean   @default(false)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bookings    Booking[]
  calendars   ExternalCalendar[]
  servicios   ServicioCuenta[]
}

model Booking {
  id              String    @id @default(cuid())
  itemId          String
  item            Item      @relation(fields: [itemId], references: [id])
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id])
  customerName    String
  customerEmail   String
  customerPhone   String?
  startDate       DateTime
  endDate         DateTime
  guests          Int       @default(1)
  totalPrice      Int
  status          String    @default("pending") // "pending" | "confirmed" | "cancelled"

  /* Cómo va el dinero — separado del estado de la reserva.
     Una reserva puede estar CONFIRMADA y sin pagar (efectivo al
     llegar o transferencia), así que "confirmada" no significa
     "pagada". Sin esta distinción, al juntar la cuenta del
     restaurante se volvería a cobrar el alojamiento a alguien que
     ya lo pagó. */
  paymentStatus   String    @default("unpaid") // "unpaid" | "paid" | "refunded"
  amountPaid      Int       @default(0)        // lo efectivamente cobrado

  stripeSessionId String?   // nombre heredado: guarda el id de MercadoPago
  paymentMethod   String?   // "card" | "transfer" | "cash"
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  /* Cuentas del restaurante que se cobran junto con esta reserva. */
  sessions        ServiceSession[]

  @@index([itemId, startDate, endDate])
  @@index([status])
  @@index([customerId])
  @@index([paymentStatus])
}

// ============================================================
// === CATÁLOGO ===============================================
// ============================================================

model Category {
  id        String     @id @default(cuid())
  name      String
  sortOrder Int        @default(0)
  kind      String
  isActive  Boolean    @default(true)
  imageUrl  String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  menuItems MenuItem[]
}

model MenuItem {
  id                     String                  @id @default(cuid())
  categoryId             String
  category               Category                @relation(fields: [categoryId], references: [id])
  name                   String
  description            String?
  basePrice              Int
  imageUrl               String?
  isActive               Boolean                 @default(true)
  prepStation            String
  estimatedPrepMinutes   Int                     @default(10)
  sortOrder              Int                     @default(0)
  sku                    String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  variants               MenuItemVariant[]
  menuItemModifierGroups MenuItemModifierGroup[]
  recipe                 Recipe?
  orderItems             OrderItem[]
  ubicaciones            MenuItemUbicacion[]

  @@index([categoryId, isActive])
}

model MenuItemVariant {
  id         String      @id @default(cuid())
  menuItemId String
  menuItem   MenuItem    @relation(fields: [menuItemId], references: [id])
  name       String
  priceDelta Int         @default(0)
  isDefault  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  orderItems OrderItem[]
}

model ModifierGroup {
  id                     String                  @id @default(cuid())
  name                   String
  minSelections          Int                     @default(0)
  maxSelections          Int                     @default(1)
  isRequired             Boolean                 @default(false)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  modifiers              Modifier[]
  menuItemModifierGroups MenuItemModifierGroup[]
}

model Modifier {
  id                   String              @id @default(cuid())
  modifierGroupId      String
  modifierGroup        ModifierGroup       @relation(fields: [modifierGroupId], references: [id])
  name                 String
  priceDelta           Int                 @default(0)
  deductsInventory     Boolean             @default(false)
  inventoryIngredientId String?
  inventoryIngredient  Ingredient?         @relation("ModifierInventoryIngredient", fields: [inventoryIngredientId], references: [id])
  inventoryQuantity    Float               @default(0)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  orderItemModifiers   OrderItemModifier[]
}

model MenuItemModifierGroup {
  id              String        @id @default(cuid())
  menuItemId      String
  menuItem        MenuItem      @relation(fields: [menuItemId], references: [id])
  modifierGroupId String
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id])

  @@unique([menuItemId, modifierGroupId])
}

// ============================================================
// === RECETAS E INVENTARIO ===================================
// ============================================================

model Ingredient {
  id             String          @id @default(cuid())
  name           String
  unit           String
  currentStock   Float           @default(0)
  minStock       Float           @default(0)
  cost           Int             @default(0)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  recipeItems    RecipeItem[]
  stockMovements StockMovement[]
  modifiers      Modifier[]         @relation("ModifierInventoryIngredient")
}

model Recipe {
  id             String       @id @default(cuid())
  menuItemId     String?      @unique
  menuItem       MenuItem?    @relation(fields: [menuItemId], references: [id])
  parentRecipeId String?
  parentRecipe   Recipe?      @relation("RecipeExtensions", fields: [parentRecipeId], references: [id])
  childRecipes   Recipe[]     @relation("RecipeExtensions")
  isTemplate     Boolean      @default(false)
  yieldQuantity  Float        @default(1)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  recipeItems    RecipeItem[]
}

model RecipeItem {
  id           String     @id @default(cuid())
  recipeId     String
  recipe       Recipe     @relation(fields: [recipeId], references: [id])
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  quantity     Float

  @@unique([recipeId, ingredientId])
}

model StockMovement {
  id           String     @id @default(cuid())
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  delta        Float
  reason       String
  unitCost     Int?
  actorName    String?
  notes        String?
  createdAt    DateTime   @default(now())

  @@index([ingredientId, createdAt])
}

// ============================================================
// === CLIENTES Y CUENTAS CORRIENTES ==========================
// ============================================================

model Customer {
  id             String                 @id @default(cuid())
  name           String
  phone          String?
  email          String?                @unique
  password       String?
  notes          String?
  hasCredit      Boolean                @default(true)
  creditLimit    Int?                   // límite de crédito en centavos (null = sin límite)
  isActive       Boolean                @default(true)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  sessions       ServiceSession[]
  ledgerEntries  CustomerLedgerEntry[]
  bookings       Booking[]
  payments       Payment[]
}

model CustomerLedgerEntry {
  id               String          @id @default(cuid())
  customerId       String
  customer         Customer        @relation(fields: [customerId], references: [id])
  amount           Int // signed: positive = customer owes us, negative = we owe customer. MXN cents.
  type             String // "CHARGE" | "PAYMENT" | "REFUND" | "ADJUSTMENT"
  serviceSessionId String?
  serviceSession   ServiceSession? @relation(fields: [serviceSessionId], references: [id])
  note             String?
  createdAt        DateTime        @default(now())

  @@index([customerId, createdAt])
}

// ============================================================
// === SALA Y SESIONES ========================================
// ============================================================

model Table {
    id        String           @id @default(cuid())
    number    String           @unique
    name      String?
    qrToken   String           @unique
    capacity  Int
    location  String?
    isActive  Boolean          @default(true)
    createdAt DateTime         @default(now())
    updatedAt DateTime         @updatedAt
    sessions  ServiceSession[]
    orders    Order[]
    ubicacionId String?
    ubicacion   Ubicacion? @relation(fields: [ubicacionId], references: [id])
  }

/* ============================================================
   UBICACIONES — un negocio, varios puntos de venta
   ============================================================
   El Hangar 5 tiene el restaurante y ahora el Café del Despegue.
   Son el MISMO negocio — misma caja, mismo personal, mismos
   clientes — pero no venden lo mismo ni se surten igual.

   En vez de duplicar el sistema, cada cosa que importa para
   "dónde" apunta aquí:
     · qué platillos se venden en cada lugar
     · de dónde salió cada pedido
     · qué almacén surte a cuál

   Si el día de mañana abren un tercer punto, es un registro más
   en esta tabla, no un sistema nuevo.
   ============================================================ */
model Ubicacion {
  id        String   @id @default(cuid())
  clave     String   @unique   // "restaurante" | "cafe"
  nombre    String              // "Restaurante" | "Café del Despegue"
  activa    Boolean  @default(true)
  orden     Int      @default(0) // para ordenar en listas
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  platillos  MenuItemUbicacion[]
  pedidos    Order[]
  mesas      Table[]
  almacenes  Almacen[]
}

/* Qué se vende en cada lugar.
   Un platillo puede estar en uno, en otro, o en los dos.
   Si no tiene fila aquí, se considera que se vende en el
   restaurante (así los 63 platillos actuales siguen funcionando
   sin tocarlos uno por uno). */
model MenuItemUbicacion {
  id         String   @id @default(cuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ubicacionId String
  ubicacion  Ubicacion @relation(fields: [ubicacionId], references: [id], onDelete: Cascade)
  disponible Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([menuItemId, ubicacionId])
  @@index([ubicacionId, disponible])
}

/* Almacén de inventario por ubicación.
   Fase 1 solo los crea; el inventario separado y los traspasos
   vienen en la fase 2. */
model Almacen {
  id          String    @id @default(cuid())
  clave       String    @unique   // "cocina" | "barra-cafe"
  nombre      String
  ubicacionId String?
  ubicacion   Ubicacion? @relation(fields: [ubicacionId], references: [id])
  activo      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/* ============================================================
   SERVICIOS VENDIDOS EN UNA CUENTA
   ============================================================
   Una moto rentada un día, dos parapentes el sábado, una bici por la
   tarde. Se apunta aquí y se cobra junto con la comida, en el mismo
   ticket.

   ── Por qué un modelo aparte y no reusar Booking ────────────────────
   Booking sirve para una reserva con fechas y ocupación (cabaña,
   moto por día). Un vuelo de parapente no ocupa equipo: se agenda a
   una hora y lo que se limita es el instructor. Meter los dos en la
   misma tabla habría obligado a llenar campos que no aplican.

   ── El campo esComision ──────────────────────────────────────────────
   Hay servicios que no son tuyos: el vuelo lo opera un tercero y tú
   te quedas un porcentaje. Cobras el total al cliente, pero a ti solo
   te entra la comisión. Sin esto, el reporte diría que ganaste el
   vuelo completo.
   ============================================================ */
model ServicioCuenta {
  id               String         @id @default(cuid())
  serviceSessionId String
  serviceSession   ServiceSession @relation(fields: [serviceSessionId], references: [id], onDelete: Cascade)

  itemId           String
  item             Item           @relation(fields: [itemId], references: [id])

  descripcion      String         // "Moto Enduro Sherco 2023", congelado al vender
  cantidad         Int            @default(1)
  precioUnitario   Int            // centavos, congelado al vender
  total            Int            // cantidad × precioUnitario
  fechaServicio    DateTime?      // cuándo se usa (renta: el día; vuelo: la fecha)
  notas            String?

  /* Si el servicio lo opera un tercero, esto guarda qué parte te
     queda a ti. null = servicio propio, te queda todo. */
  esComision       Boolean        @default(false)
  montoComision    Int?

  createdAt        DateTime       @default(now())

  @@index([serviceSessionId])
  @@index([itemId])
}

model ServiceSession {
    id         String    @id @default(cuid())
    type       String    @default("TABLE") // "TABLE" | "TAB" | "WALKIN"
    label      String    // e.g. "Mesa 5", "Grupo Juan", "Barra-1"
    folio      String?   @unique // número corto legible: "MSA-4-001"
    tableId    String?   // FK → Table (null for TAB/WALKIN)
    table      Table?    @relation(fields: [tableId], references: [id])
    customerId String?   // FK → Customer (null for anonymous)
    customer   Customer? @relation(fields: [customerId], references: [id])

    /* Cuenta unificada restaurante + alojamiento.
       null = cuenta solo de comida (lo normal).
       Si tiene valor, esta cuenta y esa reserva se cobran juntas,
       sin importar cuál de las dos se creó primero:
         · el cliente llega a comer y luego agrega la cabaña
         · el cliente ya tenía reserva y se le carga la comida          */
    bookingId  String?
    booking    Booking?  @relation(fields: [bookingId], references: [id])

    /* Servicios vendidos en esta cuenta: motos, bicis, vuelos.
       El alojamiento va por bookingId (arriba), porque una cabaña
       implica fechas y ocupación. Lo demás —una moto por un día, dos
       parapentes el sábado— se apunta aquí como una línea más de la
       cuenta, y se cobra junto con la comida.
       Antes esto no existía: la cuenta solo aceptaba platillos del
       menú, así que la renta y los vuelos no tenían dónde cobrarse. */
    servicios  ServicioCuenta[]

    status     String    @default("OPEN") // "OPEN" | "CLOSED"
    openedAt   DateTime  @default(now())
    closedAt   DateTime?
    createdAt  DateTime  @default(now())
    updatedAt  DateTime  @updatedAt
    orders     Order[]
    payments   Payment[]
    ledgerEntries CustomerLedgerEntry[]

    @@index([status, type])
    @@index([bookingId])
}

// ============================================================
// === PEDIDOS ================================================
// ============================================================

model Order {
  id                String              @id @default(cuid())
  serviceSessionId  String?             // FK → ServiceSession (null for QR direct-to-table orders)
  serviceSession    ServiceSession?     @relation(fields: [serviceSessionId], references: [id])
  tableId           String?             // FK → Table (for QR orders without a session)
  table             Table?              @relation(fields: [tableId], references: [id])

  /* Dónde se prepara y se entrega este pedido. Null = restaurante,
     que es donde estaban todos los pedidos antes del café. */
  ubicacionId       String?
  ubicacion         Ubicacion?          @relation(fields: [ubicacionId], references: [id])

  customerName      String?
  customerEmail     String?
  customerPhone     String?
  source            String
  status            String              @default("DRAFT")
  subtotal          Int                 @default(0)
  tax               Int                 @default(0)
  total             Int                 @default(0)
  notes             String?

  /* Código corto para entregar el pedido.
     Cuatro caracteres sin letras que se confunden (0/O, 1/I), para
     poder dictarlo por teléfono o leerlo de la pantalla sin errores.
     En el café es la forma de comprobar que quien recoge es quien
     pagó: sin esto, cualquiera podría decir "vengo por el pedido de
     Juan" y llevárselo. */
  codigoRecogida    String?             @unique
  entregadoAt       DateTime?

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  orderItems        OrderItem[]
  statusEvents      OrderStatusEvent[]
  payments          Payment[]

  @@index([serviceSessionId, status, createdAt])
  @@index([tableId, status, createdAt])
  @@index([source, status, createdAt])
}

model OrderItem {
  id                  String              @id @default(cuid())
  orderId             String
  order               Order               @relation(fields: [orderId], references: [id])
  menuItemId          String
  menuItem            MenuItem            @relation(fields: [menuItemId], references: [id])
  variantId           String?
  variant             MenuItemVariant?    @relation(fields: [variantId], references: [id])
  quantity            Int                 @default(1)
  unitPrice           Int
  specialInstructions String?
  status              String              @default("PENDING")
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  modifiers           OrderItemModifier[]
  statusEvents        OrderStatusEvent[]

  @@index([orderId, status])
}

model OrderItemModifier {
  id           String    @id @default(cuid())
  orderItemId  String
  orderItem    OrderItem @relation(fields: [orderItemId], references: [id])
  modifierId   String
  modifier     Modifier  @relation(fields: [modifierId], references: [id])
  modifierName String
  priceDelta   Int
}

model OrderStatusEvent {
  id          String     @id @default(cuid())
  orderId     String
  order       Order      @relation(fields: [orderId], references: [id])
  orderItemId String?
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id])
  fromStatus  String
  toStatus    String
  actorName   String?
  reason      String?
  timestamp   DateTime   @default(now())

  @@index([orderId, timestamp])
}

// ============================================================
// === PAGOS ==================================================
// ============================================================

model Payment {
  id               String           @id @default(cuid())
  orderId          String?          // FK → Order (null for ON_ACCOUNT payments)
  order            Order?           @relation(fields: [orderId], references: [id])
  serviceSessionId String?          // FK → ServiceSession (for session-level payments)
  serviceSession   ServiceSession?  @relation(fields: [serviceSessionId], references: [id])
  customerId       String?          // FK → Customer (for account payments)
  customer         Customer?        @relation(fields: [customerId], references: [id])
  amount           Int // total charged in MXN cents
  method           String // "MP" | "CASH" | "CARD" | "TRANSFER" | "ON_ACCOUNT"
  status           String           @default("PENDING") // "PENDING" | "COMPLETED" | "REFUNDED"
  note             String?
  mpPaymentId      String?
  mpPreferenceId   String?
  paidAt           DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([orderId, status])
  @@index([serviceSessionId])
  @@index([customerId])
}

// ============================================================
// === STAFF Y RRHH ===========================================
// ============================================================

model Staff {
  id         String       @id @default(cuid())
  name       String
  role       String        @default("MESERO")
  pin        String?
  phone      String?
  email      String?
  hourlyRate Int          @default(0)
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  shifts     StaffShift[]
  clocks     StaffClock[]
}

model StaffShift {
  id        String   @id @default(cuid())
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id])
  date      DateTime
  startTime DateTime
  endTime   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffId, date])
}

model StaffClock {
  id        String   @id @default(cuid())
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id])
  timestamp DateTime @default(now())
  type      String

  @@index([staffId, timestamp])
}

// ============================================================
// === iCal SYNC =============================================
// ============================================================

model ExternalCalendar {
  id        String          @id @default(cuid())
  itemId    String
  item      Item            @relation(fields: [itemId], references: [id])
  name      String
  url       String
  lastSync  DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  blocks    ExternalBlock[]

  @@unique([itemId, name])
}

model ExternalBlock {
  id         String           @id @default(cuid())
  calendarId String
  calendar   ExternalCalendar @relation(fields: [calendarId], references: [id])
  startDate  DateTime
  endDate    DateTime
  uid        String?
  createdAt  DateTime         @default(now())

  @@index([calendarId, startDate, endDate])
  @@unique([calendarId, uid])
}

// ============================================================
// === GASTOS FIJOS ===========================================
// ============================================================

model FixedExpense {
  id          String   @id @default(cuid())
  description String
  amount      Int
  category    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
